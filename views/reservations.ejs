<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Gestion des réservations</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav>
        <a href="/dashboard">Tableau de bord</a>
        <a href="/catways/manage">Gérer les catways</a>
        <a href="/users/manage">Gérer les utilisateurs</a>
        <a href="/api-docs">Documentation de l'API</a>
        <a href="/logout">Se deconnecter</a>    </nav>

    <main>
        <h1>Gestion des réservations</h1>

        <section class="create-reservation">
            <h2>Créer une réservation</h2>
            <div>
                <label for="catwayNumber">Numéro de catway</label>
                <input type="number" id="catwayNumber" required>

                <label for="clientName">Nom du client</label>
                <input type="text" id="clientName" required>

                <label for="boatName">Nom du bateau</label>
                <input type="text" id="boatName" required>

                <label for="startDate">Date de début</label>
                <input type="date" id="startDate" required>

                <label for="endDate">Date de fin</label>
                <input type="date" id="endDate" required>

                <label for="description">Description</label>
                <input type="text" id="description">

                <button onclick="createReservation()">Créer</button>
            </div>
        </section>

        <section class="list-reservations">
            <h2>Liste des réservations</h2>
            <table>
                <thead>
                    <tr>
                        <th>Catway</th>
                        <th>Client</th>
                        <th>Bateau</th>
                        <th>Début</th>
                        <th>Fin</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% reservations.forEach(function(reservation) { %>
                        <tr>
                            <td><%= reservation.catwayNumber %></td>
                            <td>
                                <input type="text" id="client-<%= reservation._id %>" value="<%= reservation.clientName %>">
                            </td>
                            <td>
                                <input type="text" id="boat-<%= reservation._id %>" value="<%= reservation.boatName %>">
                            </td>
                            <td>
                                <input type="date" id="start-<%= reservation._id %>" value="<%= reservation.startDate.toISOString().split('T')[0] %>">
                            </td>
                            <td>
                                <input type="date" id="end-<%= reservation._id %>" value="<%= reservation.endDate.toISOString().split('T')[0] %>">
                            </td>
                            <td>
                                <button onclick="updateReservation('<%= reservation.catwayNumber %>', '<%= reservation._id %>')">Modifier</button>
                                <button onclick="deleteReservation('<%= reservation.catwayNumber %>', '<%= reservation._id %>')">Supprimer</button>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </section>
    </main>

    <script src="/js/reservations.js"></script>

</body>
</html>
